<style>
  /* Base / Mobile / selain iphone xr*/
  .preset-cms {
    width: 100%;
    height: 2450px;
    border: none;
    overflow: hidden;
  }

  /* diatas iphone se (iphone xr) */
  @media (min-width: 414px) {
    .preset-cms {
      height: 2400px; /* 130vh untuk tablet kecil */
    }
  }

  /* ipad mini */
  @media (min-width: 744px) {
    .preset-cms {
     height: 2000px;
  }
 }

  /* tab mini (ipad) */
  @media (min-width: 768px) {
    .preset-cms {
      height: 1950px;
    }
  }


  /* Laptop */
  @media (min-width: 1020px) {
    .preset-cms {
      height: 1400px; /* 130vh untuk laptop FHD */
    }
  }

  /* Desktop */
  @media (min-width: 1440px) {
    .preset-cms {
      height: 1300px; /* 130vh untuk layar lebar */
    }
  }
</style>

<iframe src="https://ppkn-unpam.vercel.app/" class="preset-cms" scrolling="no">
